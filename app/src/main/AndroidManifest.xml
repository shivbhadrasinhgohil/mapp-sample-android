<?xml version="1.0" encoding="utf-8"?>
<!--
  MAPP SAMPLE APP: INTENTIONALLY INSECURE. Every weakness below is demo material
  for the MAPP Scan static APK scanner. Never ship this app or copy these settings.
  Each "MAPP demo:" comment names the scanner rule the line is meant to trigger.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MAPP demo: MANIFEST-DANGEROUS-PERMISSIONS (READ_SMS, ACCESS_FINE_LOCATION) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      MAPP demo: MANIFEST-DEBUGGABLE (debuggable="true")
      MAPP demo: MANIFEST-ALLOW-BACKUP (allowBackup="true")
      MAPP demo: MANIFEST-CLEARTEXT-TRAFFIC (usesCleartextTraffic="true")
      MAPP demo: NSC-CLEARTEXT-PERMITTED, NSC-USER-TRUST-ANCHORS, NSC-PIN-SET-WEAK
                 (see res/xml/network_security_config.xml)
    -->
    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
        android:usesCleartextTraffic="true">

        <!-- MAPP demo: SECRET-GOOGLE-API-KEY (meta-data value is the key in strings.xml) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/maps_api_key" />

        <!-- Launcher entry point: exported by design, not a finding. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          MAPP demo: MANIFEST-DEEPLINK-NOT-VERIFIED (http/https VIEW filter, no autoVerify)
          MAPP demo: MANIFEST-EXPORTED-ACTIVITY (exported, no permission)
        -->
        <activity
            android:name=".DeepLinkActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="demo.example.com" />
            </intent-filter>
        </activity>

        <!-- MAPP demo: MANIFEST-EXPORTED-PROVIDER (exported, grantUriPermissions, no permission) -->
        <provider
            android:name=".NotesProvider"
            android:authorities="com.example.mappsample.notes"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- MAPP demo: MANIFEST-EXPORTED-RECEIVER (exported, no permission) -->
        <receiver
            android:name=".DemoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.mappsample.ACTION_DEMO" />
            </intent-filter>
        </receiver>

        <!-- MAPP demo: MANIFEST-EXPORTED-SERVICE (exported, no permission) -->
        <service
            android:name=".SyncService"
            android:exported="true" />
    </application>
</manifest>
